---
import {brand} from '../../../brand.config.ts'

interface Props {
  /** Vises på undersider; forsiden har nummeret i disen i stedet. */
  number?: number
}
const {number} = Astro.props
---

<header class="masthead">
  {number && <a class="masthead__edition" href={`/nr/${number}/`}>Nr. {number}</a>}
  <a class="masthead__brand" href="/">{brand.name}</a>
  <nav class="masthead__nav" aria-label="Hovedmenu">
    <a href="/arkiv/">Tidligere uger</a>
    <a href="/dossier/">Dossierer</a>
    <a href="/om/">Hvem skriver</a>
    <button class="mode-toggle" type="button" hidden>Mørk tilstand</button>
  </nav>
</header>
