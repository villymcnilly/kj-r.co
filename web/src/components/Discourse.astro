---
/** »Set fra« – samme historie fortalt forskellige steder. */
import {bundlePath} from '../lib/content.ts'
import {typeset} from '../lib/format.ts'
import type {Bundle} from '../lib/types.ts'

interface Props {
  bundle: Bundle
  issueNumber: number
}
const {bundle, issueNumber} = Astro.props
const href = bundlePath(issueNumber, bundle.slug)
---

<section class="views" id={`opslag-${bundle.slug}`} aria-labelledby={`h-${bundle.slug}`}>
  <div class="views__head">
    <p class="label label--accent">Diskursen</p>
    <h2 class="views__headline" id={`h-${bundle.slug}`}>
      <a href={href} data-pop={bundle.slug} set:html={typeset(bundle.headline)} />
    </h2>
    {bundle.dek && <p class="views__dek">{bundle.dek}</p>}
  </div>
  <ol class="views__list">
    {
      bundle.items.map((item) => (
        <li class="view">
          <p class="view__place">Set fra {item.label}</p>
          {item.comment && <p class="view__text">{item.comment}</p>}
          <p class="meta">{item.source.outlet?.name}</p>
        </li>
      ))
    }
  </ol>
  <a class="more" href={href} data-pop={bundle.slug}>Se kilderne</a>
</section>
