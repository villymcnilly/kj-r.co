---
/** Det udfoldede opslag – bruges både i pop-out og på opslagets egen side. */
import {toHtml} from '../lib/richText.ts'
import {typeset} from '../lib/format.ts'
import type {Bundle} from '../lib/types.ts'
import SourceCard from './SourceCard.astro'

interface Props {
  bundle: Bundle
  headingLevel?: 1 | 2
}
const {bundle, headingLevel = 2} = Astro.props
const Heading = headingLevel === 1 ? 'h1' : 'h2'
---

<article class="article">
  {bundle.kicker && <p class="kicker">{bundle.kicker}</p>}
  <Heading class="article__headline" set:html={typeset(bundle.headline)} />
  {bundle.dek && <p class="article__dek">{bundle.dek}</p>}
  {bundle.body?.length ? <div class="prose" set:html={toHtml(bundle.body)} /> : null}
  <div class="article__sources">
    {bundle.items.map((item) => <SourceCard item={item} />)}
  </div>
  {
    bundle.dossiers?.length ? (
      <p class="article__dossiers">
        <span class="label">Dossierer</span>
        {bundle.dossiers.map((d) => (
          <a href={`/dossier/${d.slug}/`}>{d.name}</a>
        ))}
      </p>
    ) : null
  }
</article>
