---
/** Forsidehistorien med kilderne som marginnoter. */
import {bundlePath} from '../lib/content.ts'
import {languageLabel, sourceTypeLabel, typeset} from '../lib/format.ts'
import {toHtml} from '../lib/richText.ts'
import type {Bundle} from '../lib/types.ts'

interface Props {
  bundle: Bundle
  issueNumber: number
}
const {bundle, issueNumber} = Astro.props
const href = bundlePath(issueNumber, bundle.slug)
---

<article class="lead" id={`opslag-${bundle.slug}`}>
  <div class="lead__main">
    {bundle.kicker && <p class="kicker">{bundle.kicker}</p>}
    <h2 class="lead__headline"><a href={href} data-pop={bundle.slug} set:html={typeset(bundle.headline)} /></h2>
    {bundle.dek && <p class="lead__dek">{bundle.dek}</p>}
    {bundle.body?.length ? <div class="lead__body prose" set:html={toHtml(bundle.body)} /> : null}
    <a class="more" href={href} data-pop={bundle.slug}>Læs mine noter om det</a>
  </div>
  <aside class="notes" aria-label="Kilderne">
    <p class="label">Mine noter</p>
    <ol>
      {
        bundle.items.map((item) => (
          <li class="note">
            <p class="note__outlet">
              {item.source.outlet?.name}{' '}
              <span class="meta">
                – {sourceTypeLabel(item.source.type).toLowerCase()}, {languageLabel(item.source.language).toLowerCase()}
              </span>
            </p>
            {item.comment && <p class="note__text">{item.comment}</p>}
          </li>
        ))
      }
    </ol>
  </aside>
</article>
