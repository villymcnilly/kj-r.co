---
/** Et opslag på forsiden. Klik på overskriften folder det ud. */
import {bundlePath} from '../lib/content.ts'
import {countSources} from '../lib/format.ts'
import {toHtml} from '../lib/richText.ts'
import type {Bundle} from '../lib/types.ts'
import SourceLabel from './SourceLabel.astro'

interface Props {
  bundle: Bundle
  issueNumber: number
  variant: 'lead' | 'side'
}
const {bundle, issueNumber, variant} = Astro.props
const href = bundlePath(issueNumber, bundle.slug)
const Heading = variant === 'lead' ? 'h2' : 'h3'
---

<article class:list={['bundle', `bundle--${variant}`]} id={`opslag-${bundle.slug}`}>
  {bundle.kicker && <p class="kicker">{bundle.kicker}</p>}
  <Heading class="bundle__headline">
    <a href={href} data-pop={bundle.slug}>{bundle.headline}</a>
  </Heading>
  {bundle.dek && <p class="bundle__dek">{bundle.dek}</p>}
  {variant === 'lead' && bundle.body?.length ? <div class="bundle__body prose" set:html={toHtml(bundle.body)} /> : null}
  <ul class="bundle__items">
    {
      bundle.items.map((item) => (
        <li class="item">
          {item.label && <p class="item__label">{item.label}</p>}
          <SourceLabel source={item.source} />
          {item.comment && <p class="item__comment">{item.comment}</p>}
        </li>
      ))
    }
  </ul>
  <a class="bundle__more" href={href} data-pop={bundle.slug}>Åbn opslaget – {countSources(bundle.items.length)}</a>
</article>
