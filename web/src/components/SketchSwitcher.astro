---
/** Kun i skitsetilstand: skift mellem de tre stilretninger. */
import {themes} from '../styles/themes/index.ts'
---

<div class="sketch-bar" role="group" aria-label="Stilretning">
  <span class="sketch-bar__label">Skitse – stilretning</span>
  {
    Object.entries(themes).map(([key, t]) => (
      <button type="button" data-style-choice={key}>
        {t.name}
      </button>
    ))
  }
</div>

<style is:global>
  .sketch-bar {
    position: fixed;
    left: 50%;
    bottom: calc(12px + env(safe-area-inset-bottom, 0px));
    translate: -50% 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.35rem;
    width: max-content;
    max-width: calc(100% - 24px);
    padding: 0.4rem;
    background: var(--ink);
    color: var(--paper);
    font-family: Georgia, serif;
    font-size: 0.82rem;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.25);
  }
  .sketch-bar__label {
    padding-inline: 0.5rem;
    font-style: italic;
    opacity: 0.75;
  }
  .sketch-bar button {
    font: inherit;
    color: inherit;
    background: transparent;
    border: 1px solid color-mix(in oklch, var(--paper) 35%, transparent);
    padding: 0.35rem 0.7rem;
    cursor: pointer;
  }
  .sketch-bar button[aria-pressed='true'] {
    background: var(--paper);
    color: var(--ink);
  }
  .page {
    padding-bottom: 6rem;
  }
</style>

<script is:inline>
  ;(function () {
    var root = document.documentElement
    var buttons = document.querySelectorAll('[data-style-choice]')
    var sync = function () {
      buttons.forEach(function (b) {
        b.setAttribute('aria-pressed', String(b.dataset.styleChoice === root.dataset.style))
      })
    }
    buttons.forEach(function (b) {
      b.addEventListener('click', function () {
        root.dataset.style = b.dataset.styleChoice
        try {
          localStorage.setItem('stilretning', b.dataset.styleChoice)
        } catch (e) {}
        sync()
      })
    })
    sync()
  })()
</script>
