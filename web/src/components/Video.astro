---
import {youtubeId} from '../lib/format.ts'
import type {Video} from '../lib/types.ts'

interface Props {
  video: Video
}
const {video} = Astro.props
const id = youtubeId(video.youtubeUrl)
---

<section class="video" aria-labelledby="ugens-video">
  <h2 class="kicker" id="ugens-video">Og så en video</h2>
  <a class="video__poster" href={video.youtubeUrl} data-youtube={id} data-title={video.title} rel="noopener" target="_blank">
    <span class="video__play" aria-hidden="true"></span>
    <span class="video__title">{video.title}</span>
  </a>
  {video.description && <p class="meta">{video.description}</p>}
</section>
