---
import {bundlePath} from '../lib/content.ts'
import type {Bundle} from '../lib/types.ts'

interface Props {
  bundles: Bundle[]
  issueNumber: number
}
const {bundles, issueNumber} = Astro.props
---

<section aria-labelledby="kort-nyt">
  <h2 class="section-label" id="kort-nyt">Kort nyt</h2>
  <ul class="briefs">
    {
      bundles.map((b) => {
        const item = b.items[0]
        return (
          <li class="brief" id={`opslag-${b.slug}`}>
            {b.kicker && <p class="kicker">{b.kicker}</p>}
            <h3 class="brief__headline">
              <a href={bundlePath(issueNumber, b.slug)} data-pop={b.slug}>
                {b.headline}
              </a>
            </h3>
            {item && (
              <p class="brief__source">
                <em>{item.source.outlet?.name}</em>
                {item.comment && <> – {item.comment}</>}
              </p>
            )}
          </li>
        )
      })
    }
  </ul>
</section>
