---
import {bundlePath} from '../lib/content.ts'
import {typeset} from '../lib/format.ts'
import type {Bundle} from '../lib/types.ts'

interface Props {
  bundles: Bundle[]
  issueNumber: number
}
const {bundles, issueNumber} = Astro.props
---

<section class="briefs" aria-labelledby="kort-nyt">
  <h2 class="label" id="kort-nyt">Jeg faldt også over</h2>
  <ul>
    {
      bundles.map((b) => (
        <li class="brief" id={`opslag-${b.slug}`}>
          <h3 class="brief__headline">
            <a href={bundlePath(issueNumber, b.slug)} data-pop={b.slug} set:html={typeset(b.headline)} />
          </h3>
          {b.items[0] && <p class="meta">{b.items[0].source.outlet?.name}</p>}
        </li>
      ))
    }
  </ul>
</section>
