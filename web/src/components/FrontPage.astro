---
/** Ugens forside. Strukturen er fast – temaet bestemmer udtrykket. */
import {placedBundles} from '../lib/content.ts'
import {formatDateLong, isoWeek, typeset} from '../lib/format.ts'
import {toHtml, toPlain} from '../lib/richText.ts'
import type {Issue} from '../lib/types.ts'
import Layout from '../layouts/Layout.astro'
import Briefs from './Briefs.astro'
import BundleFull from './BundleFull.astro'
import Discourse from './Discourse.astro'
import Footer from './Footer.astro'
import Lead from './Lead.astro'
import Masthead from './Masthead.astro'
import Story from './Story.astro'
import Video from './Video.astro'

interface Props {
  issue: Issue
}
const {issue} = Astro.props
const n = issue.number
const title = issue.title || issue.lead.headline
const description = issue.openQuestion || issue.seo?.description || toPlain(issue.leader) || issue.lead.dek
---

<Layout
  title={issue.seo?.title || `Nr. ${n}: ${title}`}
  description={description}
  theme={issue.artDirection?.theme}
  issueColor={issue.artDirection?.color}
  type="article"
>
  <div class="page">
    {issue.isDummy && <p class="dummy-note">Eksempelnummer – medier, forfattere og artikler er opdigtede</p>}
    <Masthead />

    <section class="cover" aria-labelledby="forside-titel">
      <div class="cover__inner">
        <p class="cover__meta">
          <span>Nr. {n}</span>
          <span>Uge {isoWeek(issue.date)}</span>
          <span><time datetime={issue.date}>{formatDateLong(issue.date)}</time></span>
        </p>
        <h1 class="cover__title" id="forside-titel" set:html={typeset(title)} />
        {issue.openQuestion && <p class="cover__question">{issue.openQuestion}</p>}
        {issue.leader?.length ? <div class="cover__leader" set:html={toHtml(issue.leader)} /> : null}
      </div>
    </section>

    <main>
      <Lead bundle={issue.lead} issueNumber={n} />

      {
        issue.side?.length || issue.briefs?.length ? (
          <div class="secondary">
            {issue.side?.map((b) => (
              <Story bundle={b} issueNumber={n} />
            ))}
            {issue.briefs?.length ? <Briefs bundles={issue.briefs} issueNumber={n} /> : null}
          </div>
        ) : null
      }

      {issue.discourse && <Discourse bundle={issue.discourse} issueNumber={n} />}

      {
        issue.reflection?.length || issue.video ? (
          <div class="closing">
            {issue.reflection?.length ? (
              <section class="reflection" aria-labelledby="refleksion">
                <h2 class="kicker" id="refleksion">
                  Refleksion
                </h2>
                <div class="prose" set:html={toHtml(issue.reflection)} />
              </section>
            ) : null}
            {issue.video && (
              <aside class="closing__aside">
                <Video video={issue.video} />
              </aside>
            )}
          </div>
        ) : null
      }
    </main>

    <Footer />
  </div>

  {
    placedBundles(issue).map((b) => (
      <dialog class="popout" id={`pop-${b.slug}`} aria-label={b.headline}>
        <div class="popout__bar">
          <button class="popout__close" type="button">
            Luk
          </button>
        </div>
        <BundleFull bundle={b} />
      </dialog>
    ))
  }
</Layout>
